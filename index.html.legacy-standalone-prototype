<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
  <meta name="theme-color" content="#080b0d">
  <title>Arc Unified Markets</title>
  <style>
    :root{color-scheme:dark;--bg:#080b0d;--panel:#101417;--panel2:#151a1e;--line:#252c30;--text:#f3f6f5;--muted:#87918d;--green:#4ed5a5;--red:#ff6077;--yellow:#f4c95d;--blue:#5d8cff}*{box-sizing:border-box}html,body{margin:0;min-height:100%;background:var(--bg);color:var(--text);font:14px Inter,ui-sans-serif,system-ui,-apple-system,"Segoe UI",sans-serif}button,select{font:inherit}.app{min-height:100vh;display:grid;grid-template-rows:64px 1fr}.topbar{position:sticky;top:0;z-index:20;display:flex;align-items:center;gap:14px;padding:0 20px;border-bottom:1px solid var(--line);background:rgba(8,11,13,.94);backdrop-filter:blur(16px)}.logo{width:36px;height:36px;border-radius:50%;display:grid;place-items:center;background:#fff;color:#080b0d;font-size:22px;font-weight:900}.brand{font-weight:750;letter-spacing:.03em}.paper{padding:5px 8px;border:1px solid #53662f;border-radius:4px;color:#b8f45c;font-size:10px;font-weight:800;letter-spacing:.08em}.connection{margin-left:auto;display:flex;align-items:center;gap:7px;color:var(--muted);font-size:12px}.dot{width:8px;height:8px;border-radius:50%;background:var(--yellow);box-shadow:0 0 12px currentColor}.connection.live{color:var(--green)}.connection.live .dot{background:var(--green)}.connection.offline{color:var(--red)}.connection.offline .dot{background:var(--red)}.layout{display:grid;grid-template-columns:minmax(0,1fr) 370px;min-height:0}.markets{padding:24px;min-width:0}.heading{display:flex;align-items:end;gap:14px;margin-bottom:20px}.heading h1{margin:0;font-size:28px;letter-spacing:-.04em}.heading p{margin:0 0 3px;color:var(--muted);font-size:12px}.section{margin-bottom:22px;border:1px solid var(--line);border-radius:10px;background:var(--panel);overflow:hidden}.section-title{display:flex;align-items:center;padding:14px 16px;border-bottom:1px solid var(--line)}.section-title h2{margin:0;font-size:13px}.section-title span{margin-left:auto;color:var(--muted);font-size:11px}.table{width:100%;border-collapse:collapse;table-layout:fixed}.table th{height:35px;color:#717b77;font-size:10px;font-weight:600;text-align:right;padding:0 14px}.table th:first-child{text-align:left}.table td{height:52px;border-top:1px solid #1c2225;text-align:right;padding:0 14px;font-variant-numeric:tabular-nums}.table tr{transition:background .15s}.table tbody tr:hover{background:#151a1d}.asset{text-align:left!important}.asset-wrap{display:flex;align-items:center;gap:10px}.symbol{min-width:45px;height:28px;padding:0 7px;border-radius:14px;background:#242d29;color:#b8f45c;display:grid;place-items:center;font-size:10px;font-weight:800}.asset-name{display:grid;gap:2px}.asset-name b{font-size:12px}.asset-name small{color:var(--muted);font-size:9px}.price{font-family:ui-monospace,SFMono-Regular,Consolas,monospace;font-weight:700}.source{color:var(--muted);font-size:10px}.badge{display:inline-block;min-width:54px;padding:4px 6px;border-radius:4px;text-align:center;font-size:9px;font-weight:800;letter-spacing:.06em}.badge.live{background:#183329;color:var(--green)}.badge.stale{background:#332d17;color:var(--yellow)}.badge.offline{background:#3b1d24;color:var(--red)}.flash-up{animation:up .65s}.flash-down{animation:down .65s}@keyframes up{0%{background:#1d6d51;color:white}100%{background:transparent}}@keyframes down{0%{background:#7b2836;color:white}100%{background:transparent}}.agent{position:sticky;top:64px;height:calc(100vh - 64px);border-left:1px solid var(--line);background:#0d1113;padding:22px;overflow:auto}.eyebrow{color:#b8f45c;font-size:9px;font-weight:800;letter-spacing:.14em}.agent h2{font-size:22px;margin:9px 0 7px}.agent>p{color:var(--muted);font-size:11px;line-height:1.55}.control{display:grid;gap:7px;margin-top:20px;color:#939d98;font-size:10px}.control select{height:44px;border:1px solid var(--line);border-radius:6px;background:var(--panel2);color:var(--text);padding:0 11px}.run{width:100%;height:44px;margin-top:12px;border:0;border-radius:6px;background:#b8f45c;color:#10160c;font-weight:850;cursor:pointer}.run:disabled{opacity:.55;cursor:wait}.research{min-height:220px;margin-top:18px;border:1px solid var(--line);border-radius:7px;background:var(--panel);padding:15px}.research.empty{display:grid;place-content:center;text-align:center;color:var(--muted);font-size:11px}.research header{display:flex;align-items:center;gap:8px}.research header b{font-size:14px}.confidence{margin-left:auto;color:#b8f45c;font:700 13px ui-monospace,monospace}.time{display:block;color:var(--muted);font-size:9px;margin-top:5px}.evidence{padding-left:18px;margin:18px 0}.evidence li{margin:9px 0;color:#c3cbc7;font-size:11px;line-height:1.4}.plan{display:grid;grid-template-columns:1fr 1fr;gap:7px}.plan span{background:#171d20;padding:10px;color:var(--muted);font-size:9px}.plan b{display:block;color:#fff;font:12px ui-monospace,monospace;margin-top:4px}.decision{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-top:12px}.decision button{height:40px;border-radius:5px;font-weight:800;cursor:pointer}.approve{border:0;background:var(--green);color:#092118}.reject{border:1px solid #4a3037;background:transparent;color:var(--red)}.decision button:disabled{opacity:.4;cursor:not-allowed}.notice{margin-top:12px;padding:10px;border-radius:5px;background:#18201a;color:#b8f45c;font-size:10px;display:none}.notice.show{display:block}.disclaimer{color:#626c67!important;font-size:9px!important;margin-top:16px!important}.empty-state td{height:88px;color:var(--muted);text-align:center!important}.sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}
    @media(max-width:900px){.layout{grid-template-columns:1fr}.agent{position:relative;top:0;height:auto;border-left:0;border-top:1px solid var(--line)}.markets{padding:18px}.agent{padding-bottom:calc(24px + env(safe-area-inset-bottom))}}
    @media(max-width:600px){.app{grid-template-rows:56px 1fr}.topbar{height:56px;padding:0 12px;gap:9px}.logo{width:31px;height:31px;font-size:18px}.brand{font-size:12px}.paper{font-size:8px;padding:4px 5px}.connection span:last-child{display:none}.markets{padding:14px 10px}.heading{display:block}.heading h1{font-size:23px}.heading p{margin-top:5px}.section{border-radius:7px}.table th:nth-child(3),.table td:nth-child(3){display:none}.table th,.table td{padding:0 8px}.table th:nth-child(1){width:42%}.table th:nth-child(2){width:30%}.table th:nth-child(4){width:28%}.asset-wrap{gap:7px}.symbol{min-width:38px;height:25px;font-size:8px}.source{font-size:8px}.badge{min-width:48px;font-size:8px}.agent{padding:20px 14px}.agent h2{font-size:20px}}
    @media(prefers-reduced-motion:reduce){.flash-up,.flash-down{animation:none}}
    .flash-up{animation:none!important;background:transparent!important;color:var(--green)!important}.flash-down{animation:none!important;background:transparent!important;color:var(--red)!important}.chartcard{border:1px solid var(--line);border-radius:10px;background:var(--panel);margin-bottom:22px;overflow:hidden}.charthead{height:48px;display:flex;align-items:center;gap:12px;padding:0 14px;border-bottom:1px solid var(--line)}.charthead b{font-size:12px}.charthead select{margin-left:auto;height:31px;border:1px solid var(--line);border-radius:5px;background:var(--panel2);color:#fff}.legend{display:flex;gap:10px;color:var(--muted);font-size:8px}.legend i{width:9px;height:2px;display:inline-block;margin-right:3px}.chartbox{height:620px}.chartcredit{padding:5px 10px;color:#66706b;font-size:8px;text-align:right}.chartcredit a{color:#7f8b85}@media(max-width:600px){.chartbox{height:520px}.legend{display:none}.charthead{padding:0 8px}}
  </style>
</head>
<body>
<div class="app">
  <header class="topbar"><div class="logo">A</div><div class="brand">ARC MARKETS</div><span class="paper">PAPER ONLY</span><div id="connection" class="connection"><i class="dot"></i><span>Connecting to gateway</span></div></header>
  <main class="layout">
    <section class="markets"><div class="heading"><h1>Unified markets</h1><p>Cryptocurrency, US equities, and foreign exchange in one real-time feed.</p></div><section class="chartcard"><div class="charthead"><b id="chartTitle">BTC-USD technical chart</b><div class="legend"><span><i style="background:#4d8dff"></i>EMA 50</span><span><i style="background:#b891ff"></i>Bollinger</span><span>RSI 14</span><span>MACD</span></div><select id="chartSymbol"></select></div><div id="chart" class="chartbox"></div><div class="chartcredit">Charts by <a href="https://www.tradingview.com/" target="_blank" rel="noopener">TradingView</a></div></section><div id="sections"></div></section>
    <aside class="agent"><span class="eyebrow">AGENT RESEARCH COMMAND</span><h2>Evidence before action</h2><p>Request a timestamped market scan, then approve or reject the proposed paper trade. Approval never submits a live order.</p><label class="control">Select asset<select id="researchSymbol"></select></label><button id="runResearch" class="run">Run research</button><div id="research" class="research empty">Choose an asset and run a fresh evidence scan.</div><div class="decision"><button id="approve" class="approve" disabled>Approve paper plan</button><button id="reject" class="reject" disabled>Reject</button></div><div id="notice" class="notice"></div><p class="disclaimer">Research simulation only. Not financial advice. Every approved plan remains a local paper-trading record.</p></aside>
  </main>
</div>
<script src="https://unpkg.com/lightweight-charts@5.0.8/dist/lightweight-charts.standalone.production.js"></script>
<script>
  const ASSETS=[{symbol:"BTC-USD",name:"Bitcoin",group:"Cryptocurrency"},{symbol:"ETH-USD",name:"Ethereum",group:"Cryptocurrency"},{symbol:"AAPL",name:"Apple",group:"Stocks"},{symbol:"NVDA",name:"NVIDIA",group:"Stocks"},{symbol:"EUR/USD",name:"Euro / US Dollar",group:"Forex"}];
  const params=new URLSearchParams(location.search);const API_BASE=params.get("api")||(location.port==="8080"?location.origin:"http://localhost:8080");const WS_BASE=API_BASE.replace(/^http/,"ws");
  const prices=new Map(),lastSeen=new Map(),rows=new Map();let socket,retry=1000,reconnectTimer,currentResearch=null,activeChartSymbol="BTC-USD",candles=[];
  const sections=document.getElementById("sections"),connection=document.getElementById("connection"),selector=document.getElementById("researchSymbol"),chartSelector=document.getElementById("chartSymbol"),researchBox=document.getElementById("research"),runButton=document.getElementById("runResearch"),approve=document.getElementById("approve"),reject=document.getElementById("reject"),notice=document.getElementById("notice");
  const money=value=>{if(!Number.isFinite(value))return "—";const digits=value<1?5:value<10?4:2;return new Intl.NumberFormat("en-US",{style:"currency",currency:"USD",minimumFractionDigits:digits,maximumFractionDigits:digits}).format(value)};
  const LC=window.LightweightCharts,chart=LC.createChart(document.getElementById("chart"),{layout:{background:{type:"solid",color:"#101417"},textColor:"#87918d",panes:{separatorColor:"#252c30",separatorHoverColor:"#384247",enableResize:true}},grid:{vertLines:{color:"#1b2124"},horzLines:{color:"#1b2124"}},rightPriceScale:{borderColor:"#252c30"},timeScale:{borderColor:"#252c30",timeVisible:true,secondsVisible:false}});const candleSeries=chart.addSeries(LC.CandlestickSeries,{upColor:"#4ed5a5",downColor:"#ff6077",borderVisible:false,wickUpColor:"#4ed5a5",wickDownColor:"#ff6077"},0),emaSeries=chart.addSeries(LC.LineSeries,{color:"#4d8dff",lineWidth:2,priceLineVisible:false,lastValueVisible:false},0),bbTop=chart.addSeries(LC.LineSeries,{color:"#b891ff",lineWidth:1,priceLineVisible:false,lastValueVisible:false},0),bbMid=chart.addSeries(LC.LineSeries,{color:"#8c6fc7",lineWidth:1,priceLineVisible:false,lastValueVisible:false},0),bbBottom=chart.addSeries(LC.LineSeries,{color:"#b891ff",lineWidth:1,priceLineVisible:false,lastValueVisible:false},0),rsiSeries=chart.addSeries(LC.LineSeries,{color:"#f4c95d",lineWidth:2,priceLineVisible:false},1),macdSeries=chart.addSeries(LC.LineSeries,{color:"#4d8dff",lineWidth:2,priceLineVisible:false},2),signalSeries=chart.addSeries(LC.LineSeries,{color:"#ff9f43",lineWidth:2,priceLineVisible:false},2),histSeries=chart.addSeries(LC.HistogramSeries,{priceLineVisible:false,lastValueVisible:false},2);rsiSeries.createPriceLine({price:70,color:"#ff6077",lineWidth:1,lineStyle:LC.LineStyle.Dashed,axisLabelVisible:true,title:"70"});rsiSeries.createPriceLine({price:30,color:"#4ed5a5",lineWidth:1,lineStyle:LC.LineStyle.Dashed,axisLabelVisible:true,title:"30"});new ResizeObserver(entries=>chart.resize(entries[0].contentRect.width,entries[0].contentRect.height)).observe(document.getElementById("chart"));
  function ema(values,period){const k=2/(period+1),out=[];let value=values[0];for(let i=0;i<values.length;i++){value=i?values[i]*k+value*(1-k):values[i];out.push(value)}return out}
  function indicators(){const close=candles.map(x=>x.close),times=candles.map(x=>x.time),ema50=ema(close,50),fast=ema(close,12),slow=ema(close,26),macd=fast.map((x,i)=>x-slow[i]),signal=ema(macd,9);emaSeries.setData(times.map((time,i)=>({time,value:ema50[i]})).slice(49));const top=[],mid=[],bottom=[];for(let i=19;i<close.length;i++){const w=close.slice(i-19,i+1),m=w.reduce((a,b)=>a+b,0)/20,sd=Math.sqrt(w.reduce((a,b)=>a+(b-m)**2,0)/20);mid.push({time:times[i],value:m});top.push({time:times[i],value:m+2*sd});bottom.push({time:times[i],value:m-2*sd})}bbTop.setData(top);bbMid.setData(mid);bbBottom.setData(bottom);const rsi=[];let gain=0,loss=0;for(let i=1;i<close.length;i++){const d=close[i]-close[i-1],g=Math.max(d,0),l=Math.max(-d,0);if(i<=14){gain+=g;loss+=l;if(i===14){gain/=14;loss/=14;rsi.push({time:times[i],value:loss?100-100/(1+gain/loss):100})}}else{gain=(gain*13+g)/14;loss=(loss*13+l)/14;rsi.push({time:times[i],value:loss?100-100/(1+gain/loss):100})}}rsiSeries.setData(rsi);macdSeries.setData(times.map((time,i)=>({time,value:macd[i]})).slice(25));signalSeries.setData(times.map((time,i)=>({time,value:signal[i]})).slice(33));histSeries.setData(times.map((time,i)=>({time,value:macd[i]-signal[i],color:macd[i]-signal[i]>=0?"rgba(78,213,165,.7)":"rgba(255,96,119,.7)"})).slice(33))}
  async function loadChart(symbol){activeChartSymbol=symbol;document.getElementById("chartTitle").textContent=`${symbol} technical chart`;const r=await fetch(`${API_BASE}/api/candles?symbol=${encodeURIComponent(symbol)}`,{cache:"no-store"}),data=await r.json();if(!data.candles)throw new Error(data.error||"Candle history unavailable");candles=data.candles.filter(x=>[x.open,x.high,x.low,x.close,x.time].every(Number.isFinite));candleSeries.setData(candles);indicators();chart.timeScale().fitContent()}
  function updateRealtimeCandle(tick){if(tick.symbol!==activeChartSymbol||!Number.isFinite(Number(tick.price)))return;const time=Math.floor(Date.now()/60000)*60,price=Number(tick.price),last=candles.at(-1);if(last?.time===time){last.high=Math.max(last.high,price);last.low=Math.min(last.low,price);last.close=price;candleSeries.update(last)}else{const open=last?.close||price,c={time,open,high:price,low:price,close:price};candles.push(c);if(candles.length>300)candles.shift();candleSeries.update(c)}indicators()}
  function build(){for(const group of ["Cryptocurrency","Stocks","Forex"]){const assets=ASSETS.filter(a=>a.group===group),section=document.createElement("section");section.className="section";section.innerHTML=`<div class="section-title"><h2>${group}</h2><span>${assets.length} assets</span></div><table class="table"><thead><tr><th>Asset</th><th>Last price</th><th>Source</th><th>Status</th></tr></thead><tbody></tbody></table>`;const body=section.querySelector("tbody");for(const asset of assets){const tr=document.createElement("tr");tr.innerHTML=`<td class="asset"><div class="asset-wrap"><span class="symbol">${asset.symbol.split(/[-/]/)[0]}</span><span class="asset-name"><b>${asset.symbol}</b><small>${asset.name}</small></span></div></td><td class="price">—</td><td class="source">Waiting</td><td><span class="badge offline">OFFLINE</span></td>`;body.appendChild(tr);rows.set(asset.symbol,tr);const option=document.createElement("option");option.value=asset.symbol;option.textContent=`${asset.symbol} — ${asset.name}`;selector.appendChild(option)}sections.appendChild(section)}}
  function setConnection(state,text){connection.className=`connection ${state}`;connection.querySelector("span").textContent=text}
  function updateTick(tick){const row=rows.get(tick.symbol);if(!row||!Number.isFinite(Number(tick.price)))return;const next=Number(tick.price),old=prices.get(tick.symbol),cell=row.querySelector(".price");prices.set(tick.symbol,next);lastSeen.set(tick.symbol,Date.now());cell.textContent=money(next);cell.classList.remove("flash-up","flash-down");if(Number.isFinite(old)&&next!==old)cell.classList.add(next>old?"flash-up":"flash-down");row.querySelector(".source").textContent=tick.source||"Gateway";const badge=row.querySelector(".badge");badge.className="badge live";badge.textContent="LIVE";updateRealtimeCandle(tick)}
  function applySnapshot(data){for(const tick of Object.values(data||{}))updateTick(tick)}
  function connect(){clearTimeout(reconnectTimer);setConnection("","Connecting to gateway");socket=new WebSocket(WS_BASE);socket.onopen=()=>{retry=1000;setConnection("live","Unified feed live")};socket.onmessage=event=>{try{const message=JSON.parse(event.data);if(message.type==="snapshot")applySnapshot(message.data);if(message.type==="tick")updateTick(message)}catch{}};socket.onerror=()=>socket.close();socket.onclose=()=>{setConnection("offline","Gateway offline");reconnectTimer=setTimeout(connect,retry);retry=Math.min(30000,retry*2)}}
  setInterval(()=>{const now=Date.now();for(const asset of ASSETS){const badge=rows.get(asset.symbol).querySelector(".badge"),age=now-(lastSeen.get(asset.symbol)||0);if(age>5000&&age<=15000){badge.className="badge stale";badge.textContent="STALE"}else if(age>15000){badge.className="badge offline";badge.textContent="OFFLINE"}}},1000);
  runButton.onclick=async()=>{runButton.disabled=true;runButton.textContent="Researching…";notice.className="notice";approve.disabled=reject.disabled=true;try{const response=await fetch(`${API_BASE}/api/research?symbol=${encodeURIComponent(selector.value)}`,{cache:"no-store"});const result=await response.json();if(result.error)throw new Error(result.error);currentResearch=result;researchBox.className="research";researchBox.innerHTML=`<header><b>${result.symbol} · ${result.signal}</b><span class="confidence">${result.confidence}%</span></header><span class="time">Generated ${new Date(result.generatedAt).toLocaleString()} · source tick ${new Date(result.sourceTimestamp).toLocaleTimeString()}</span><ul class="evidence">${result.evidence.map(item=>`<li>${item}</li>`).join("")}</ul><div class="plan"><span>Side<b>${result.paperTradePlan.side.toUpperCase()}</b></span><span>Entry<b>${money(result.paperTradePlan.entry)}</b></span><span>Stop<b>${money(result.paperTradePlan.stop)}</b></span><span>Target<b>${money(result.paperTradePlan.target)}</b></span></div>`;approve.disabled=reject.disabled=false}catch(error){researchBox.className="research empty";researchBox.textContent=error.message||"Research is temporarily unavailable."}finally{runButton.disabled=false;runButton.textContent="Run research"}};
  approve.onclick=()=>{if(!currentResearch)return;const records=JSON.parse(localStorage.getItem("arc-approved-paper-plans")||"[]");records.unshift({...currentResearch,decision:"approved",decidedAt:new Date().toISOString()});localStorage.setItem("arc-approved-paper-plans",JSON.stringify(records.slice(0,100)));notice.textContent="Paper plan approved and saved locally. No live order was sent.";notice.className="notice show";approve.disabled=reject.disabled=true};
  reject.onclick=()=>{notice.textContent="Plan rejected. No order or position was created.";notice.className="notice show";approve.disabled=reject.disabled=true;currentResearch=null};
  build();for(const asset of ASSETS){const o=document.createElement("option");o.value=asset.symbol;o.textContent=asset.symbol;chartSelector.appendChild(o)}chartSelector.onchange=()=>loadChart(chartSelector.value).catch(error=>{document.getElementById("chartTitle").textContent=error.message});loadChart("BTC-USD").catch(()=>{});connect();
</script>
</body>
</html>
